# Copy this file to .env and adjust the values. Never commit .env.

# PostgreSQL
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl
POSTGRES_DB=cbar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CBAR API client
CBAR_BASE_URL=https://www.cbar.az/currencies
REQUEST_TIMEOUT=15
REQUEST_DELAY=0.2
MAX_RETRIES=3
RETRY_BACKOFF=1.0

# Logging
LOG_LEVEL=INFO
